<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fonrapor.flow-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.11</string>
        <string>/Users/admin/Documents/Projects/fon-app/scripts/snapshot_flows.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/admin/Documents/Projects/fon-app</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Her gün UTC 10:00 = TR 13:00 (TEFAS + fund_cascade sonrası, değerler güncel) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>10</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/admin/Library/Logs/fonrapor/flow_snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/admin/Library/Logs/fonrapor/flow_snapshot.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
